<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="5dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            style="@style/TextAppearance.Calc.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINANCEIRO"
            android:textColor="@color/accent" />

        <TextView
            style="@style/TextAppearance.Calc.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cálculos do dia a dia"
            android:textSize="24sp" />

        <TextView
            style="@style/TextAppearance.Calc.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desconto, porcentagem, regra de 3, gorjeta, juros e financiamento. Fórmulas transparentes." />

        <LinearLayout
            android:id="@+id/toolsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
