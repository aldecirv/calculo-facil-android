<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="5dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            style="@style/TextAppearance.Calc.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONVERSORES"
            android:textColor="@color/cyan" />

        <TextView
            style="@style/TextAppearance.Calc.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Converter unidades"
            android:textSize="24sp" />

        <TextView
            style="@style/TextAppearance.Calc.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comprimento, massa, temperatura, moedas e mais." />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Calc.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fromLayout"
                    style="@style/Widget.Calc.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="De">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/fromUnit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="none"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/valueLayout"
                    style="@style/Widget.Calc.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Valor">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/valueInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="2dp">

                    <ImageButton
                        android:id="@+id/swap"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pill"
                        android:contentDescription="Inverter unidades"
                        android:padding="9dp"
                        android:src="@drawable/ic_swap"
                        app:tint="@color/accent" />
                </FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/toLayout"
                    style="@style/Widget.Calc.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Para">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/toUnit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="none"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_display"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Calc.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESULTADO" />

                    <TextView
                        android:id="@+id/result"
                        style="@style/TextAppearance.Calc.H1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textColor="@color/accent"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/formula"
                        style="@style/TextAppearance.Calc.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>

                <TextView
                    android:id="@+id/note"
                    style="@style/TextAppearance.Calc.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="@color/amber"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
