<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/TextAppearance.Calc.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Ajustes"
            android:textSize="17sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="5dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextAppearance.Calc.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNIDADE ANGULAR"
                android:textColor="@color/accent" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Calc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <RadioGroup
                    android:id="@+id/angleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/angleDeg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Graus (DEG)"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/angleRad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Radianos (RAD)"
                        android:textColor="@color/text_secondary" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Calc.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="FORMATO DOS NÚMEROS"
                android:textColor="@color/accent" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Calc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <RadioGroup
                    android:id="@+id/formatGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/formatBr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Português (1.234,56)"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/formatUs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Internacional (1,234.56)"
                        android:textColor="@color/text_secondary" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Calc.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CASAS DECIMAIS"
                android:textColor="@color/accent" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Calc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/precisionGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="9dp"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/precisionAuto"
                        style="@style/Widget.Calc.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/precision2"
                        style="@style/Widget.Calc.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/precision4"
                        style="@style/Widget.Calc.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/precision6"
                        style="@style/Widget.Calc.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/precision8"
                        style="@style/Widget.Calc.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8" />
                </com.google.android.material.chip.ChipGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Calc.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="FEEDBACK"
                android:textColor="@color/accent" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Calc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Calc.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vibração ao tocar" />

                        <TextView
                            style="@style/TextAppearance.Calc.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Feedback tátil nas teclas" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/vibrationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Calc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Calc.BodyStrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cálculo Fácil 1.0.0" />

                    <TextView
                        style="@style/TextAppearance.Calc.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Calculadora offline. Sem internet, sem anúncios, sem conta e sem enviar seus cálculos para nenhum servidor. As taxas de moedas são referências offline e podem ficar desatualizadas." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
