<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_logo">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calculate"
                app:tint="@color/bg" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Calc.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cálculo Fácil"
                android:textSize="18sp" />

            <TextView
                style="@style/TextAppearance.Calc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rápido, científico e completo."
                android:textSize="9.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ajustes"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navBasic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconBasic"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_calculate"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/labelBasic"
                style="@style/TextAppearance.Calc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Básica"
                android:textColor="@color/accent"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navScientific"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconScientific"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_science"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/labelScientific"
                style="@style/TextAppearance.Calc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Científica"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navConverters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconConverters"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_swap"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/labelConverters"
                style="@style/TextAppearance.Calc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Conversores"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFinance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconFinance"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_trending"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/labelFinance"
                style="@style/TextAppearance.Calc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Financeiro"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconHistory"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_history"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/labelHistory"
                style="@style/TextAppearance.Calc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Histórico"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
