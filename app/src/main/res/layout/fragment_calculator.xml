<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/displayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_display"
            android:minHeight="164dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/modeLabel"
                        style="@style/TextAppearance.Calc.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CÁLCULO BÁSICO"
                        android:textColor="@color/accent" />

                    <TextView
                        android:id="@+id/angleLabel"
                        style="@style/TextAppearance.Calc.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="DEG"
                        android:textColor="@color/accent"
                        android:textSize="8.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/expression"
                    style="@style/TextAppearance.Calc.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:maxLines="3"
                    android:minHeight="38dp"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/preview"
                    style="@style/TextAppearance.Calc.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/accent"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/error"
                    style="@style/TextAppearance.Calc.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/rose"
                    android:textSize="9.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mc"
                style="@style/Widget.Calc.Button.Text"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="MC"
                android:textSize="9.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mr"
                style="@style/Widget.Calc.Button.Text"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="MR"
                android:textSize="9.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mPlus"
                style="@style/Widget.Calc.Button.Text"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="M+"
                android:textSize="9.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mMinus"
                style="@style/Widget.Calc.Button.Text"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="M−"
                android:textSize="9.5sp" />

            <ImageButton
                android:id="@+id/backspace"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Apagar último caractere"
                android:padding="8dp"
                android:src="@drawable/ic_backspace"
                app:tint="@color/text_tertiary" />

            <ImageButton
                android:id="@+id/copy"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copiar resultado"
                android:padding="8dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/text_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scientificPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
